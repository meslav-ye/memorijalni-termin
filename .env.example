# Predlozak varijabli okoline. Kopiraj u .env.local i popuni.
# Ova datoteka IDE u repo i ne smije sadrzavati stvarne vrijednosti.

# Adresa Supabase projekta.
#   lokalno:    http://127.0.0.1:54321
#   produkcija: https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Javni kljuc — salje se pregledniku svakog posjetitelja, stiti ga RLS a ne tajnost.
# Novi format: sb_publishable_...   (stariji projekti imaju dugacki JWT)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Tajni kljuc — ZAOBILAZI SVA RLS PRAVILA.
# Koristi se iskljucivo u server actionima, nikad u kodu koji ide pregledniku.
# Novi format: sb_secret_...        (stariji projekti imaju service_role JWT)
SUPABASE_SERVICE_ROLE_KEY=

# Referenca produkcijskog projekta, za `supabase link --project-ref`.
SUPABASE_PROJECT_REF=
